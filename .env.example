# URL where the Vite dev server binds.
# Change these to relocate the frontend without editing vite.config.ts.
VITE_HOST=::
VITE_PORT=8080

# Backend API origin.
#
# - LOCAL DEV: leave this EMPTY (or unset). The SPA will use same-origin
#   relative paths (/api, /ws) and the Vite dev server will proxy them to
#   http://localhost:3001 based on the value below.
# - PRODUCTION: set this to the absolute URL of your deployed backend, e.g.
#   https://my-backend.onrender.com — the client derives the WS URL by
#   swapping http(s):// → ws(s):// and appending /ws.
#
# The Vite dev proxy still reads this at `npm run dev` time to know where
# localhost:3001 lives; empty falls back to that default.
VITE_BACKEND_URL= 
