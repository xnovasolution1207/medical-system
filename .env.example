# URL where the Vite dev server binds.
# Change these to relocate the frontend without editing vite.config.ts.
VITE_HOST=::
VITE_PORT=8080

# Backend API origin that Vite proxies /api and /ws to.
# Use http(s):// — the WebSocket proxy derives ws(s):// from the same value.
VITE_BACKEND_URL=http://localhost:3001
